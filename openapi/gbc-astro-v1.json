            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Three totals -- supportive, challenging and activity -- with every contact that produced them. Deliberately not a percentage."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
