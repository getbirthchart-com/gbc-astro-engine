        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "angles": {},
                  "aspects": [],
                  "bodies": {},
                  "derived": {},
                  "houses": [],
                  "meta": {
                    "calculationProfile": "western-modern-v1",
                    "engine": "gbc-astro",
                    "engineVersion": "0.1.0",
                    "houseSystem": "placidus",
                    "zodiac": "tropical"
                  },
                  "schemaVersion": "1.0.0",
                  "subject": {
                    "birthTimeKnown": true,
                    "localDateTime": "1996-06-14T04:12:00",
                    "timezone": "Europe/Lisbon"
                  },
                  "warnings": []
                },
                "schema": {}
              }
            },
            "description": "Canonical natal chart object (NatalChart.to_dict()). Returned directly \u2014 not wrapped in a {chart: ...} envelope."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
