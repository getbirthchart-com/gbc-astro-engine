{
  "components": {
    "schemas": {
      "ApiErrorBody": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "additionalProperties": true,
            "title": "Details",
            "type": "object"
          },
          "field": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Field"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ApiErrorBody",
        "type": "object"
      },
      "ApiErrorEnvelope": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ApiErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ApiErrorEnvelope",
        "type": "object"
      },
      "EventSearchRequest": {
        "additionalProperties": false,
        "description": "A numerical event search over a time window.",
        "properties": {
          "aspect_angle": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Required for exact_aspect, in degrees.",
            "title": "Aspect Angle"
          },
          "body": {
            "examples": [
              "mercury",
              "sun"
            ],
            "title": "Body",
            "type": "string"
          },
          "end": {
            "description": "Window end, UTC ISO 8601.",
            "title": "End",
            "type": "string"
          },
          "event_type": {
            "description": "Which kind of event to locate.",
            "enum": [
              "sign_ingress",
              "station",
              "exact_longitude",
              "exact_aspect"
            ],
            "title": "Event Type",
            "type": "string"
          },
          "start": {
            "description": "Window start, UTC ISO 8601.",
            "title": "Start",
            "type": "string"
          },
          "target_longitude": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Required for exact_longitude and exact_aspect.",
            "title": "Target Longitude"
          }
        },
        "required": [
          "event_type",
          "body",
          "start",
          "end"
        ],
        "title": "EventSearchRequest",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "api_version": {
            "title": "Api Version",
            "type": "string"
          },
          "engine": {
            "title": "Engine",
            "type": "string"
          },
          "engine_version": {
            "title": "Engine Version",
            "type": "string"
          },
          "schema_version": {
            "title": "Schema Version",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "engine",
          "engine_version",
          "schema_version",
          "api_version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "HouseSystem": {
        "description": "House systems supported by AstrologyEngine.natal.",
        "enum": [
          "placidus",
          "whole_sign",
          "equal"
        ],
        "title": "HouseSystem",
        "type": "string"
      },
      "NatalChartRequest": {
        "additionalProperties": false,
        "description": "Natal chart calculation request.\n\nPreserves local civil date + optional local clock time + IANA timezone.\nThe engine owns historical timezone / DST interpretation \u2014 clients must not\npre-convert to UTC.",
        "examples": [
          {
            "latitude": 38.7223,
            "local_date": "1996-06-14",
            "local_time": "04:12",
            "longitude": -9.1393,
            "timezone": "Europe/Lisbon",
            "unknown_time": false
          },
          {
            "latitude": 38.7223,
            "local_date": "1996-06-14",
            "longitude": -9.1393,
            "timezone": "Europe/Lisbon",
            "unknown_time": true
          }
        ],
        "properties": {
          "altitude_m": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional altitude in meters.",
            "title": "Altitude M"
          },
          "fold": {
            "anyOf": [
              {
                "enum": [
                  0,
                  1
                ],
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional PEP 495 fold for ambiguous local times. Do not invent a fold; omit and surface AMBIGUOUS_LOCAL_TIME when unresolved.",
            "title": "Fold"
          },
          "house_system": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/HouseSystem"
              },
              {
                "type": "null"
              }
            ],
            "description": "House system. Defaults to the engine calculation profile (western-modern-v1 \u2192 placidus). No silent fallback between systems."
          },
          "latitude": {
            "description": "WGS84 latitude in degrees (-90 to 90).",
            "title": "Latitude",
            "type": "number"
          },
          "local_date": {
            "description": "Local civil birth date as YYYY-MM-DD.",
            "examples": [
              "1996-06-14"
            ],
            "title": "Local Date",
            "type": "string"
          },
          "local_time": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Local clock time as HH:MM or HH:MM:SS when birth time is known. Must be null when unknown_time is true.",
            "examples": [
              "04:12",
              "04:12:00"
            ],
            "title": "Local Time"
          },
          "longitude": {
            "description": "WGS84 longitude in degrees (-180 to 180).",
            "title": "Longitude",
            "type": "number"
          },
          "timezone": {
            "description": "IANA timezone identifier (not a fixed UTC offset).",
            "examples": [
              "Europe/Lisbon",
              "Asia/Ho_Chi_Minh"
            ],
            "minLength": 1,
            "title": "Timezone",
            "type": "string"
          },
          "unknown_time": {
            "default": false,
            "description": "When true, birth time is unknown. Angles/houses are omitted by the engine; local_time must be null.",
            "title": "Unknown Time",
            "type": "boolean"
          }
        },
        "required": [
          "local_date",
          "timezone",
          "latitude",
          "longitude"
        ],
        "title": "NatalChartRequest",
        "type": "object"
      },
      "RelationshipRequest": {
        "additionalProperties": false,
        "description": "Two natal subjects for a synastry or composite chart.\n\nEach side carries the same fields as a natal request, so historical\ntimezone and DST interpretation stay with the engine on both sides.",
        "examples": [
          {
            "chart_a": {
              "latitude": 21.0285,
              "local_date": "1992-11-03",
              "local_time": "14:35",
              "longitude": 105.8542,
              "timezone": "Asia/Ho_Chi_Minh"
            },
            "chart_b": {
              "latitude": 52.52,
              "local_date": "1990-06-21",
              "local_time": "08:20",
              "longitude": 13.405,
              "timezone": "Europe/Berlin"
            }
          }
        ],
        "properties": {
          "chart_a": {
            "$ref": "#/components/schemas/NatalChartRequest",
            "description": "First subject."
          },
          "chart_b": {
            "$ref": "#/components/schemas/NatalChartRequest",
            "description": "Second subject."
          }
        },
        "required": [
          "chart_a",
          "chart_b"
        ],
        "title": "RelationshipRequest",
        "type": "object"
      },
      "ReturnRequest": {
        "additionalProperties": false,
        "description": "A natal subject, a body, and the window to search for its returns.",
        "properties": {
          "body": {
            "description": "Body whose return to find, for example 'sun' or 'saturn'.",
            "examples": [
              "sun",
              "moon",
              "saturn"
            ],
            "title": "Body",
            "type": "string"
          },
          "include_charts": {
            "default": false,
            "description": "Cast a chart for each exact return.",
            "title": "Include Charts",
            "type": "boolean"
          },
          "natal": {
            "$ref": "#/components/schemas/NatalChartRequest",
            "description": "The natal subject."
          },
          "window_end": {
            "description": "Window end, UTC ISO 8601.",
            "title": "Window End",
            "type": "string"
          },
          "window_start": {
            "description": "Window start, UTC ISO 8601.",
            "title": "Window Start",
            "type": "string"
          }
        },
        "required": [
          "natal",
          "body",
          "window_start",
          "window_end"
        ],
        "title": "ReturnRequest",
        "type": "object"
      },
      "TransitRequest": {
        "additionalProperties": false,
        "description": "A natal subject plus the instant to read the sky at.",
        "properties": {
          "include_natal_chart": {
            "default": false,
            "description": "Embed the full natal chart in the response.",
            "title": "Include Natal Chart",
            "type": "boolean"
          },
          "natal": {
            "$ref": "#/components/schemas/NatalChartRequest",
            "description": "The natal subject."
          },
          "target_instant": {
            "description": "UTC instant to calculate transits for, ISO 8601.",
            "examples": [
              "2026-08-08T12:00:00Z"
            ],
            "title": "Target Instant",
            "type": "string"
          }
        },
        "required": [
          "natal",
          "target_instant"
        ],
        "title": "TransitRequest",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Thin HTTP adapter over the gbc-astro AstrologyEngine. All natal calculations are performed by the existing Python engine; this service does not reimplement astrology math, geocoding, persistence, or interpretation.",
    "title": "GetBirthChart Astrology API",
    "version": "v1",
    "x-gbc-api-version": "v1",
    "x-gbc-engine-version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Service health",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/charts/compatibility": {
      "post": {
        "operationId": "calculate_compatibility_v1_charts_compatibility_post",
